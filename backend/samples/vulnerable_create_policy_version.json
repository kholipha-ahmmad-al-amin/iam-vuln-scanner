{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowPolicyVersionExploit",
      "Effect": "Allow",
      "Action": [
        "iam:CreatePolicyVersion",
        "iam:SetDefaultPolicyVersion",
        "iam:GetPolicy",
        "iam:GetPolicyVersion"
      ],
      "Resource": "*"
    }
  ]
}
